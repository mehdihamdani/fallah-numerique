{
  "entities": {
    "AgriculturalParcel": {
      "title": "AgriculturalParcel",
      "description": "Delimited agricultural plot with WGS84 satellite polygon, borehole telemetry, soil lab parameters, and crop campaign data.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated farmer/operator UID owning this parcel."
        },
        "name": {
          "type": "string",
          "description": "Sector or parcel title (e.g., قطاع بسكرة - طولقة)."
        },
        "wilaya": {
          "type": "string",
          "description": "Administrative Wilaya code and name."
        },
        "commune": {
          "type": "string",
          "description": "Commune and agricultural zone."
        },
        "ilotNumber": {
          "type": "string",
          "description": "Cadastral ilot and parcel reference code."
        },
        "tenureType": {
          "type": "string",
          "description": "Land tenure classification (e.g., Concession, Melk)."
        },
        "areaHectares": {
          "type": "number",
          "description": "Calibrated surface area in hectares."
        },
        "coordinatesLabel": {
          "type": "string",
          "description": "WGS84 centroid coordinate string."
        },
        "polygonPoints": {
          "type": "array",
          "description": "Bounded list (3..20) of normalized x,y polygon vertices."
        },
        "wellPoint": {
          "type": "string",
          "description": "Normalized x,y coordinate of irrigation borehole (Forage)."
        },
        "wellDepthLabel": {
          "type": "string",
          "description": "Borehole label and depth in meters."
        },
        "ndviScore": {
          "type": "number",
          "description": "Latest satellite NDVI vegetation vigor index (0.0 to 1.0)."
        },
        "soilTexture": {
          "type": "string",
          "enum": ["sableux_limoneux", "argileux", "limoneux", "calcaire"],
          "description": "Predominant soil texture classification."
        },
        "soilPh": {
          "type": "number",
          "description": "Soil pH level (3.0 to 11.0)."
        },
        "organicMatterPercent": {
          "type": "number",
          "description": "Soil organic matter percentage."
        },
        "salinityEc": {
          "type": "number",
          "description": "Electrical conductivity / salinity in dS/m."
        },
        "drainageStatus": {
          "type": "string",
          "description": "Root depth and water infiltration status."
        },
        "labDocumentName": {
          "type": "string",
          "description": "Attached INRAA / laboratory certificate file name."
        },
        "mainCrop": {
          "type": "string",
          "enum": ["deglet_nour", "pomme_de_terre", "olivier", "tomate_industrielle"],
          "description": "Primary cultivated crop code."
        },
        "irrigationSystem": {
          "type": "string",
          "description": "Adopted irrigation method."
        },
        "estimatedYieldTonsPerHa": {
          "type": "number",
          "description": "Estimated yield in metric tons per hectare."
        },
        "plantingYear": {
          "type": "string",
          "description": "Year of plantation or start of exploitation."
        },
        "intercropping": {
          "type": "string",
          "description": "Associated intercropping cultures."
        },
        "linkedToMarket": {
          "type": "boolean",
          "description": "Whether this parcel is linked to a public market harvest listing."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "name",
        "wilaya",
        "commune",
        "ilotNumber",
        "tenureType",
        "areaHectares",
        "coordinatesLabel",
        "polygonPoints",
        "wellPoint",
        "wellDepthLabel",
        "ndviScore",
        "soilTexture",
        "soilPh",
        "organicMatterPercent",
        "salinityEc",
        "drainageStatus",
        "labDocumentName",
        "mainCrop",
        "irrigationSystem",
        "estimatedYieldTonsPerHa",
        "plantingYear",
        "intercropping",
        "linkedToMarket",
        "createdAt",
        "updatedAt"
      ]
    },
    "MarketListing": {
      "title": "MarketListing",
