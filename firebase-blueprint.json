        },
        "dayKey": {
          "type": "string",
          "description": "UTC calendar date key formatted YYYY-MM-DD."
        },
        "dailyRequestCount": {
          "type": "integer",
          "description": "Requests executed on dayKey (0..100)."
        },
        "dailyTokensEstimate": {
          "type": "integer",
          "description": "Estimated cumulative tokens on dayKey (0..300000)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "userId",
        "dayKey",
        "dailyRequestCount",
        "dailyTokensEstimate",
        "updatedAt"
      ]
    },
    "EditorialAdminRecord": {
      "title": "EditorialAdminRecord",
      "description": "Server-provisioned editorial administrator marker granting Fellah Matin publishing and source moderation permissions.",
      "type": "object",
      "properties": {
        "adminId": {
          "type": "string",
          "description": "UID of authorized editorial administrator."
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when editorial privilege was provisioned."
        }
      },
      "required": ["adminId", "grantedAt"]
    },
    "NewsArticleRecord": {
      "title": "NewsArticleRecord",
      "description": "Verified agricultural news item in Fellah Matin separating original publication date from platform retrieval timestamp.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "description": "Editorial admin UID who imported or published the article."
        },
        "title": {
          "type": "string",
          "description": "Original article headline (4..240 chars)."
        },
        "summary": {
          "type": "string",
          "description": "Concise attributed summary without full-text republication (10..1200 chars)."
        },
        "sourceName": {
          "type": "string",
          "description": "Official institution, meteorological office, research institute, or publication name."
        },
        "originalUrl": {
          "type": "string",
          "description": "Validated https:// canonical link to original article."
        },
        "publishedAtIso": {
          "type": "string",
          "description": "Original source publication timestamp in ISO-8601 format."
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Platform retrieval/verification server timestamp via FieldValue.serverTimestamp()."
        },
        "category": {
          "type": "string",
          "enum": [
            "gov_announcements",
            "crop_production",
            "market_availability",
            "weather_alerts",
            "inputs_and_machinery",
            "transport_logistics",
            "cold_storage_postharvest",
            "services_and_training",
            "research_and_tech",
            "events_and_fairs"
          ],
          "description": "Canonical Fellah Matin news category."
        },
        "language": {
          "type": "string",
          "enum": ["AR", "FR", "EN"],
          "description": "Article language code."
        },
        "wilaya": {
          "type": "string",
          "description": "Verified Wilaya or geographic scope when supported by source, or empty string for national/general."
        },
        "imageUrl": {
          "type": "string",
          "description": "Optional permitted https:// image URL or empty string."
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["verified_source", "editorial_verified", "unverified"],
          "description": "Source verification classification."
        },
        "moderationStatus": {
          "type": "string",
          "enum": ["pending_review", "approved", "rejected"],
          "description": "Editorial moderation state; only approved articles are visible to general users."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "authorId",
        "title",
        "summary",
        "sourceName",
        "originalUrl",
        "publishedAtIso",
        "retrievedAt",
        "category",
        "language",
        "wilaya",
        "imageUrl",
        "verificationStatus",
        "moderationStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "NewsSourceRecord": {
      "title": "NewsSourceRecord",
      "description": "Configured external RSS or institutional agricultural news source managed by editorial administrators.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name of the official institution or publication."
        },
        "baseUrl": {
          "type": "string",
          "description": "Validated https:// institutional base URL."
        },
        "feedUrl": {
          "type": "string",
          "description": "Validated https:// RSS/Atom feed endpoint URL."
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "official_institution",
            "meteorological",
            "research_university",
            "agri_publication",
            "market_data",
            "logistics_regulatory"
          ],
          "description": "Institutional classification of the news source."
        },
        "language": {
          "type": "string",
          "enum": ["AR", "FR", "EN"],
          "description": "Primary language of the source."
        },
        "isEnabled": {
          "type": "boolean",
          "description": "Whether automatic ingestion is enabled for this source."
        },
        "lastError": {
          "type": "string",
          "description": "Sanitized diagnostic error from last ingestion check, or empty string."
        },
        "lastCheckedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last ingestion attempt via FieldValue.serverTimestamp()."
        },
        "updatedBy": {
          "type": "string",
          "description": "Editorial admin UID who last updated this source."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "name",
        "baseUrl",
        "feedUrl",
        "sourceType",
        "language",
        "isEnabled",
        "lastError",
        "lastCheckedAt",
        "updatedBy",
        "updatedAt"
      ]
    },
    "UserNewsPreferences": {
      "title": "UserNewsPreferences",
      "description": "Per-user Fellah Matin category, region, and language preferences.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated user UID matching document ID."
        },
        "preferredCategories": {
          "type": "array",
          "description": "Bounded list (0..10) of preferred Fellah Matin category codes."
        },
        "preferredRegion": {
          "type": "string",
          "description": "Preferred Wilaya or region filter, or empty string for all Algeria."
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["ALL", "AR", "FR", "EN"],
          "description": "Preferred news language filter."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "preferredCategories",
        "preferredRegion",
        "preferredLanguage",
        "createdAt",
        "updatedAt"
      ]
    }
  },
